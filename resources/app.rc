#include <windows.h>
101 ICON "jack-snip.ico"
1 RT_MANIFEST "app.manifest"
1 VERSIONINFO
 FILEVERSION 1,0,1,0
 PRODUCTVERSION 1,0,1,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "Jack Snip - native screenshot editor\0"
   VALUE "ProductName", "Jack Snip\0"
   VALUE "FileVersion", "1.0.1\0"
   VALUE "OriginalFilename", "JackSnip.exe\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
